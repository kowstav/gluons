{
  "id": "stock-monitor",
  "version": "1.0.0",
  "layer": "core",
  "name": "Stock monitor",
  "description": "Flag low inventory before the next rush.",
  "triggers": ["scheduled_check", "manual"],
  "inputs": {
    "business": "BusinessSetup",
    "request": "TaskInput"
  },
  "outputs": {
    "proposal": "ProposedAction"
  },
  "decisions": [
    {
      "id": "needs_human",
      "engine": "jev",
      "type": "yes_no",
      "question": "Is this request unclear, unusual, sensitive or high-value?"
    }
  ],
  "actions": [
    {
      "id": "stock_alert",
      "risk": "low",
      "requires_approval": true
    }
  ],
  "models": {
    "default": "cheap",
    "escalate_to": "frontier"
  },
  "human_minutes_per_task": 8,
  "tests": "tests/handler.test.ts"
}
