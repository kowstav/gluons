{
  "id": "daily-report",
  "version": "1.0.0",
  "layer": "core",
  "name": "Daily report",
  "description": "Prepare an owner-ready operations brief.",
  "triggers": ["daily_schedule", "manual"],
  "inputs": {
    "business": "BusinessSetup",
    "request": "TaskInput"
  },
  "outputs": {
    "proposal": "ProposedAction"
  },
  "decisions": [
    {
      "id": "needs_human",
      "engine": "jev",
      "type": "yes_no",
      "question": "Is this request unclear, unusual, sensitive or high-value?"
    }
  ],
  "actions": [
    {
      "id": "daily_report",
      "risk": "low",
      "requires_approval": true
    }
  ],
  "models": {
    "default": "cheap",
    "escalate_to": "frontier"
  },
  "human_minutes_per_task": 20,
  "tests": "tests/handler.test.ts"
}
