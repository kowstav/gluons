# Defaults work without keys. Copy this file to apps/dashboard/.env.local.
GLUONS_AI_MODE=demo
GLUONS_ALLOW_LOCAL_DEMO=true
# Optional absolute path; defaults to apps/dashboard/.data/workspace.json.
# GLUONS_DATA_PATH=

# Required for hosted Vercel use. Apply supabase/migrations/001_gluons.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only set gateway mode when you want billable model requests.
AI_GATEWAY_API_KEY=
AI_MODEL_CHEAP=anthropic/claude-haiku-5.5
AI_MODEL_MEDIUM=anthropic/claude-sonnet-5.5
AI_MODEL_FRONTIER=anthropic/claude-opus-5.5
# Snapshot USD/1M tokens, 2026-10-28; override to match your provider bill.
AI_CHEAP_INPUT_RATE=0.10
AI_CHEAP_OUTPUT_RATE=0.50
AI_MEDIUM_INPUT_RATE=2
AI_MEDIUM_OUTPUT_RATE=10
AI_FRONTIER_INPUT_RATE=4
AI_FRONTIER_OUTPUT_RATE=20
JEV_INPUT_USD_PER_MILLION=0.04

# Live service integrations (server-side secrets only).
LIVE_ACTIONS_ENABLED=false
PUBLIC_APP_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
VAPI_WEBHOOK_SECRET=
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
WEBHOOK_OWNER_ID=
WEBHOOK_BUSINESS_ID=business-morning-table

LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
